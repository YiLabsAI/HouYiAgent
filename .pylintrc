[MASTER]
# Use multiple processes to speed up Pylint
jobs=4

# Pickle collected data for later comparisons
persistent=yes

# List of plugins (as comma separated values of python module names)
load-plugins=

# Allow loading of arbitrary C extensions
unsafe-load-any-extension=no

[MESSAGES CONTROL]
# Disable specific warnings
disable=
    # Duplicate code in tests is acceptable
    duplicate-code,
    # Too few public methods is fine for simple classes
    too-few-public-methods,
    # Missing docstrings in tests
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    # Line too long (handled by ruff)
    line-too-long,
    # Import order (handled by ruff)
    wrong-import-order,
    wrong-import-position,
    # Naming conventions (handled by ruff)
    invalid-name,
    # Too many arguments/locals/branches (subjective)
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-instance-attributes,
    too-many-positional-arguments,
    # Fixme comments are okay during development
    fixme,
    # Protected access is sometimes necessary
    protected-access,
    # Broad except is sometimes necessary
    broad-except,
    # Cyclic imports are handled with lazy imports
    cyclic-import,
    # Import outside toplevel is intentional for lazy loading
    import-outside-toplevel,
    # Redefining built-in 'input' is acceptable in evaluation context
    redefined-builtin,
    # Unused arguments in abstract methods/placeholders
    unused-argument,
    # Reimport is intentional for type checking
    reimported,
    redefined-outer-name,
    # Unnecessary else/elif after return (stylistic choice)
    no-else-return,
    # Consider-using-in (stylistic)
    consider-using-in,
    # Unnecessary pass (sometimes needed for clarity)
    unnecessary-pass,
    # Arguments renamed in override (intentional for clarity)
    arguments-renamed,
    # No-member false positives with Pydantic
    no-member,
    # Eval is used safely in assertion checking
    eval-used,
    # Not-an-iterable false positives with Pydantic
    not-an-iterable,
    # Unexpected keyword arg false positives with external libraries
    unexpected-keyword-arg,
    # Trailing newlines
    trailing-newlines,
    # Unspecified encoding (now fixed)
    unspecified-encoding

[REPORTS]
# Set the output format
output-format=colorized

# Tells whether to display a full report or only the messages
reports=no

# Python expression which should return a score less than or equal to 10
evaluation=10.0 - ((float(5 * error + warning + refactor + convention) / statement) * 10)

[BASIC]
# Good variable names which should always be accepted
good-names=i,j,k,ex,Run,_,x,y,z,a,b,e,f,id,db

# Regular expression matching correct function names
function-rgx=[a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct variable names
variable-rgx=[a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct constant names
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$

# Regular expression matching correct attribute names
attr-rgx=[a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct argument names
argument-rgx=[a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct class attribute names
class-attribute-rgx=([A-Za-z_][A-Za-z0-9_]{2,50}|(__.*__))$

# Regular expression matching correct class names
class-rgx=[A-Z_][a-zA-Z0-9]+$

# Regular expression matching correct module names
module-rgx=(([a-z_][a-z0-9_]*)|([A-Z][a-zA-Z0-9]+))$

[FORMAT]
# Maximum number of characters on a single line
max-line-length=120

# Maximum number of lines in a module
max-module-lines=1500

# String used as indentation unit
indent-string='    '

# Number of spaces of indent required inside a hanging or continued line
indent-after-paren=4

[DESIGN]
# Maximum number of arguments for function / method
max-args=10

# Maximum number of locals for function / method body
max-locals=25

# Maximum number of return / yield for function / method body
max-returns=6

# Maximum number of branch for function / method body
max-branches=20

# Maximum number of statements in function / method body
max-statements=100

# Maximum number of parents for a class
max-parents=7

# Maximum number of attributes for a class
max-attributes=15

# Minimum number of public methods for a class
min-public-methods=0

# Maximum number of public methods for a class
max-public-methods=30

[IMPORTS]
# Deprecated modules which should not be used
deprecated-modules=optparse,imp

# Allow wildcard imports from modules that define __all__
allow-wildcard-with-all=no

[CLASSES]
# List of method names used to declare instance attributes
defining-attr-methods=__init__,__new__,setUp

# List of valid names for the first argument in a class method
valid-classmethod-first-arg=cls

# List of valid names for the first argument in a metaclass class method
valid-metaclass-classmethod-first-arg=mcs

[EXCEPTIONS]
# Exceptions that will emit a warning when being caught
overgeneral-exceptions=builtins.Exception
