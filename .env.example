# Houyi LLM API Configuration
# Copy this file to .env and fill in the values

# ===== LLM Providers =====

# OpenAI
OPENAI_API_KEY=sk-xxx

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# SiliconFlow (DeepSeek)
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3

# Google Vertex AI (Gemini)
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.0-flash
# Optional: path to service account key (if not using ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Default LLM provider (openai, anthropic, vertex, siliconflow)
DEFAULT_LLM_PROVIDER=vertex

# ===== Web Search =====

# Tavily API (optional)
TAVILY_API_KEY=tvly-xxx

# Serper API (optional)
SERPER_API_KEY=xxx

# ===== RAG Configuration =====

# Default knowledge base directory
RAG_KNOWLEDGE_DIR=knowledge/

# Default embedding provider (openai, anthropic, local)
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
