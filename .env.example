# Houyi Configuration
# Copy this file to .env and fill in your values

# ===== LLM Providers =====

# SiliconFlow (DeepSeek)
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3

# OpenAI
OPENAI_API_KEY=sk-xxx

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# Google Gemini — two API modes:
#
#   Mode 1: Vertex AI (supports ALL models including preview)
#     Needs GOOGLE_CLOUD_PROJECT (auto-detected from SA JSON if available)
#     Auth: service account, ADC (gcloud auth), or GCP API key
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
#   Mode 2: Developer API (AI Studio key, simplest setup)
#     Only needs GOOGLE_API_KEY (get from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=AIza-your-ai-studio-key
#
GEMINI_MODEL=gemini-2.5-pro

# Default LLM provider: siliconflow | vertex
DEFAULT_LLM_PROVIDER=siliconflow

# ===== Web Search =====

# Default provider: serper | tavily | bocha | ddg | searxng
# WEB_SEARCH_PROVIDER=ddg

TAVILY_API_KEY=tvly-xxx
SERPER_API_KEY=xxx
BOCHA_API_KEY=sk-xxx

# ===== Knowledge Base =====

RAG_KNOWLEDGE_DIR=knowledge/

# Embedding provider: local (fastembed), openai, gemini
# If not set, auto-detects: Gemini → OpenAI → local
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
