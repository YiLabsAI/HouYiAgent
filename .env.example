# Houyi Configuration
# Copy this file to .env and fill in your values

# ===== LLM Providers =====

# SiliconFlow (DeepSeek)
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3

# Alibaba Cloud Bailian
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# OpenAI
OPENAI_API_KEY=sk-xxx

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# Google Gemini — two API modes:
#
#   Mode 1: Vertex AI (supports ALL models including preview)
#     Needs GOOGLE_CLOUD_PROJECT (auto-detected from SA JSON if available)
#     Auth: service account, ADC (gcloud auth), or GCP API key
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
#   Mode 2: Developer API (AI Studio key, simplest setup)
#     Only needs GOOGLE_API_KEY (get from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=AIza-your-ai-studio-key
#
GEMINI_MODEL=gemini-2.5-pro

# Default LLM provider: siliconflow | vertex
DEFAULT_LLM_PROVIDER=siliconflow

# ===== Web Search =====

# Default provider: serper | tavily | bocha | ddg | searxng
# WEB_SEARCH_PROVIDER=ddg

TAVILY_API_KEY=tvly-xxx
SERPER_API_KEY=xxx
BOCHA_API_KEY=sk-xxx

# ===== Jina Reader (web scraping) =====

# Jina API key — optional but strongly recommended for Bench II FACT scraping.
# Without key: uses unauthenticated r.jina.ai/http/ (low success rate, rate-limited).
# With key:    uses r.jina.ai/ with Bearer auth (high success rate, ~10x throughput).
# Get a free key at https://jina.ai/reader/
JINA_API_KEY=jina_xxx

# ===== Bench II Evaluation =====

# LLM provider for Bench II sidecar (default: siliconflow)
# HOUYI_BENCH2_PROVIDER=siliconflow

# Model for RACE evaluation (default: uses DEFAULT_LLM_PROVIDER model)
# HOUYI_BENCH2_RACE_MODEL=

# Model for FACT evaluation (default: uses DEFAULT_LLM_PROVIDER model)
# HOUYI_BENCH2_FACT_MODEL=

# FACT stage tuning
# HOUYI_BENCH2_FACT_MAX_TOKENS=6000
# HOUYI_BENCH2_FACT_CALL_RETRIES=3
# HOUYI_BENCH2_FACT_TIMEOUT_SECONDS=90

# ===== Knowledge Base =====

RAG_KNOWLEDGE_DIR=knowledge/

# Embedding provider: local (fastembed), openai, gemini
# If not set, auto-detects: Gemini → OpenAI → local
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
